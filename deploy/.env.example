# Local image built by Compose. Replace with a registry tag when publishing.
DENSO_IMAGE=denso-arena:local
# Set Y only after accepting the NVIDIA Isaac Sim EULA.
ACCEPT_EULA=N
# Keep this on a persistent disk. Deleting the disk also deletes the data.
DENSO_DATA_DIR=/srv/denso
# idle = ready environment; teleop = automatic G1/CloudXR after initial testing.
ARENA_MODE=idle
